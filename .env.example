# Copy to .env and set real values before exposing this app beyond localhost.

# Host port the app is published on (container always listens on 8000).
APP_PORT=8000

# PostgreSQL (docker-compose). The app's DATABASE_URL is built from these in
# docker-compose.yml; override there if you point at an external database.
POSTGRES_USER=grc
POSTGRES_PASSWORD=grc
POSTGRES_DB=grc

AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Signs session cookies. Set a fixed random value (e.g. `openssl rand -hex 32`)
# so logins survive container restarts; if unset, a new one is generated on
# every startup and all existing sessions are invalidated.
SESSION_SECRET_KEY=
